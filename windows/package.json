{
  "name": "jot-windows",
  "version": "0.4.28",
  "description": "TakkieAI smart dictation for Windows, powered by Gemini",
  "main": "src/main/index.js",
  "author": "Jot contributors",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:native && electron .",
    "start": "npm run dev",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "test": "node --test test/*.test.js",
    "lint": "node scripts/check.js",
    "build": "npm run lint && npm test && npm run build:native && electron-builder --win nsis --x64 --publish never",
    "pack": "npm run build:native && electron-builder --dir --win --x64"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "electron-updater": "^6.8.9",
    "ws": "^8.21.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.ammaar.jot",
    "productName": "TakkieAI",
    "artifactName": "TakkieAI-${version}-Windows-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "native/bin/JotNativeHelper.exe",
      "native/bin/TakkieProcessAudio.exe",
      "native/bin/TakkieMeetingDetector.exe",
      "package.json",
      "scripts/smoke.js"
    ],
    "asarUnpack": [
      "native/bin/JotNativeHelper.exe",
      "native/bin/TakkieProcessAudio.exe",
      "native/bin/TakkieMeetingDetector.exe"
    ],
    "extraResources": [
      {
        "from": "../App/Resources/Fonts",
        "to": "fonts"
      },
      {
        "from": "../App/Resources/Sounds",
        "to": "sounds"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TakkieAI",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Famingg1",
        "repo": "Jot-Gemini",
        "releaseType": "release"
      }
    ]
  }
}
